# ---------------------------------------------------------------------------
# lptrader environment — copy to `.env` and fill in. `.env` is gitignored.
# NEVER commit real keys/passphrases/private keys. No private key belongs here:
# the signing key lives encrypted in secrets/wallet.enc (see scripts/keystore-init.ts).
# ---------------------------------------------------------------------------

# --- Chain access (read-only RPC; primary + optional failover, baseline §99) ---
#
# LEAVE EMPTY TO USE THE PUBLIC DEFAULTS, which are verified working:
#     https://bsc-dataseed.bnbchain.org  +  https://bsc-rpc.publicnode.com
#
# Only set these if you have a private endpoint. PITFALLS we have actually hit:
#   * Infura does NOT serve BNB Chain's JSON-RPC properly — `eth_gasPrice` returns
#     "An internal error was received". An Infura BSC URL looks plausible and passes
#     some calls, then fails others. Do not use it here.
#   * The API key usually sits IN the URL path (…/v3/<key>), so a wrong endpoint both
#     breaks the bot AND can leak the key into logs. Error output is scrubbed now, but
#     prefer endpoints whose key is not in the path.
#   * Give TWO endpoints once you go to production: the bot cross-checks critical reads
#     between them (baseline §99), and a single endpoint is a single point of failure.
BSC_RPC_URL=
BSC_RPC_URL_SECONDARY=

# --- Market/pool data sources (all optional; keyless endpoints are used when empty) ---
GECKOTERMINAL_API=
DEXPAPRIKA_API=
DEFILLAMA_API=
THEGRAPH_API_KEY=

# --- Binance reference price (public endpoints; empty = public default host) ---
BINANCE_FAPI_BASE_URL=

# --- Telegram bot: push alerts + interactive query + approval gate (see src/types/notifier.ts) ---
# Empty TELEGRAM_BOT_TOKEN disables the Telegram channel (config strategy.telegram.enabled must agree).
# TELEGRAM_ALLOWED_USER_IDS: comma-separated numeric Telegram user ids allowed to approve/query.
# TELEGRAM_ENABLED: optional; when set it overrides strategy.telegram.enabled (0/false disables).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ENABLED=
# Optional Bot API host; leave empty for https://api.telegram.org (self-hosted Bot API / offline tests).
TELEGRAM_API_BASE_URL=

# --- Wallet / keystore (baseline §92: dedicated strategy wallet only) ---
# Address of the dedicated Strategy Wallet (audit/assert only; never a key).
STRATEGY_WALLET_ADDRESS=
# Path to the AES-256-GCM keystore envelope produced by `npm run keystore:init`.
#
# LEAVE THIS COMMENTED OUT UNTIL THE KEYSTORE EXISTS. An empty/unset KEYSTORE_PATH means
# "no signer", so the bot runs as a read-only monitor — which is exactly the right state
# before a wallet has been created. Setting it while secrets/wallet.enc is missing makes
# startup abort by design (fail closed), and that is the most common first-run error.
#
# After `npm run keystore:init` succeeds, uncomment the line below.
#KEYSTORE_PATH=secrets/wallet.enc

# chainId bound into the keystore AAD; MUST match the value used at creation.
# Only consulted when KEYSTORE_PATH is set.
KEYSTORE_CHAIN_ID=56

# Unattended start: the keystore passphrase, so no terminal is needed.
# Without it you are prompted — which works at a terminal AND from a pipe:
#   printf '%s' 'your passphrase' | ./scripts/lptrader.sh start
#   KEYSTORE_PASSPHRASE='your passphrase' ./scripts/lptrader.sh start
# An environment variable is visible to anything that can read this process's environment,
# so prefer the prompt on a shared host.
#KEYSTORE_PASSPHRASE=

# --- Runtime ---
# Set to 1 to make the scheduler refuse every write path (dry-run / Phase A).
DRY_RUN=1
