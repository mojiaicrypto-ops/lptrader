{
  "name": "lptrader",
  "version": "0.1.0",
  "private": true,
  "description": "Tokenized Stock LP Auto Strategy \u2014 BNB Chain CLMM LP automation (Phase 3: single pool)",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:approval": "vitest run approvalGate telegram",
    "test:watch": "vitest",
    "dev": "node --experimental-strip-types --env-file-if-exists=.env src/main.ts",
    "keystore:init": "node --experimental-strip-types --env-file-if-exists=.env scripts/keystore-init.ts",
    "telegram:check": "node --experimental-strip-types --env-file-if-exists=.env scripts/telegram-check.ts"
  },
  "dependencies": {
    "@pancakeswap/chains": "0.10.0",
    "@pancakeswap/sdk": "5.9.3",
    "@pancakeswap/smart-router": "7.8.0",
    "@pancakeswap/v3-sdk": "3.10.3",
    "viem": "2.37.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
