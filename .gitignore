# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Secrets — never commit key material, passphrases or decrypted output
secrets/
*.enc
.env
.env.*
!.env.example

# Runtime state written by scripts/lptrader.sh: the pid file and the rotated logs.
/run/
/logs/

# Runtime state / local databases. Anchored to the repo root: an unanchored `data/` also matched
# `src/data/**` and `tests/data/**`, which silently left the whole data layer untracked.
/data/
*.sqlite
*.sqlite-*
*.db
*.db-journal
*.db-wal

# Tooling / OS noise
coverage/
.vitest/
.DS_Store
*.log

# Throwaway probes / scratch (never commit; see AGENTS.md Settlement rule 3)
scratch-*.mjs
scratch-*.ts
.tmp/
